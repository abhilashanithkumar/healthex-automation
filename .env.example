# Copy to .env.local, which is ignored. CI environment variables take precedence.
HEALTHEX_BASE_URL=https://app.healthex.io
HEALTHEX_PUBLIC_URL=https://healthex.io
HEALTHEX_GOOGLE_EMAIL=
HEALTHEX_GOOGLE_PASSWORD=
HEALTHEX_RECOVERY_PHONE=
HEALTHEX_PROVIDER=
HEALTHEX_KAISER_USERNAME=
HEALTHEX_KAISER_PASSWORD=
HEALTHEX_CONSENT_NAME=
HEALTHEX_ACCOUNT_INITIALS=
HEALTHEX_AUTH_STATE=playwright/.auth/healthex.json
HEALTHEX_FIXTURE_FILE=playwright/.auth/fixtures.json
HEALTHEX_CDP_ENDPOINT=http://127.0.0.1:19333
# Dedicated profile reused by auth:open and automatic test-run startup.
HEALTHEX_CHROME_PROFILE=playwright/.auth/chrome-profile
# cdp uses the verified regular Chrome context with a new page per test.
# state uses isolated contexts with saved HealthEx state if supported by deployment.
HEALTHEX_AUTH_MODE=cdp
HEALTHEX_CLOSE_BROWSER_AFTER_RUN=true
# Optional: comma-separated exact hosts or suffixes prefixed with a dot.
# HEALTHEX_ALLOWED_POPUP_HOSTS=
# HEALTHEX_CHROME_EXECUTABLE=/path/to/installed/google-chrome
HEALTHEX_HEADLESS=false
HEALTHEX_SLOW_MO=0
HEALTHEX_SYNC_TIMEOUT=120000
HEALTHEX_EXPORT_TIMEOUT=120000
HEALTHEX_TEST_TIMEOUT=300000

# Enable only for the specifically authorized execution and matching fixtures.
HEALTHEX_GOOGLE_LOGIN=false
# Optional private multi-account chooser fixture for AUTH-04 only.
# HEALTHEX_GOOGLE_ACCOUNT_STATE=playwright/.auth/google-chooser.json
HEALTHEX_RECOVERY_PHONE_CHALLENGE=false
HEALTHEX_EMPTY_WALLET=false
HEALTHEX_ALLOW_MUTATIONS=false
HEALTHEX_ALLOW_CONSENT=false
HEALTHEX_ALLOW_PROVIDER_GRANT=false
HEALTHEX_FASTEN_DURATION=1 hour
HEALTHEX_FASTEN_CATEGORY_COUNT=19
HEALTHEX_CONTROLLED_FIXTURES=false
HEALTHEX_KNOWN_PRINT_SCOPE_BUG=false

